# Salin file ini jadi .env lalu isi. JANGAN commit .env ke GitHub.

NODE_ENV=development
PORT=3000

# Origin frontend yang boleh akses API (pisahkan dengan koma). Live Server VS Code defaultnya
# jalan di 127.0.0.1, browser modern (Chrome) sering redirect ke localhost — isi keduanya biar aman.
# Di production isi domain GitHub Pages kamu, mis: https://username.github.io
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Rahasia untuk menandatangani token login. Minimal 32 karakter acak.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=6h

# ID spreadsheet = bagian panjang di URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Dari file JSON service account (Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tulis di satu baris, newline diganti \n , dan apit dengan tanda kutip
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cache baca Sheet dalam milidetik (mengurangi risiko kena rate limit Google)
SHEETS_CACHE_TTL_MS=3000
